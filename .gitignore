# Build output
/out/

# Logs, dumps and clips players sent in; a dump can hold their sign-in details
/RandoLogs/
/githubreports/

# Machine-local presets (hold this machine's SDK path)
CMakeUserPresets.json

# IDE state
.vs/
.vscode/
*.code-workspace

# Game data the user supplies (see assets/.gitignore and generated/.gitignore)
*.iso
*.xexp

# Shader containers and the guest image written by --kameo_gfx_dump_shaders
/shader_dump/
guest_image.bin
*.log

# Python
__pycache__/
