# Visual Studio / IDE droppings
.vs/
.vscode/
KameoRePowered.code-workspace

# Machine-local presets (hardcode this machine's SDK install path)
CMakeUserPresets.json

# Build output
/out/
*.pdb
*.ilk
*.exp
*.lib
*.exe

# rexglue migration backups
CMakeLists.txt.bak
src/main.cpp.bak

# Generated recomp sources
/generated/

# Runtime artifacts — binary, logs, and bundled shared libraries
/sdk/
/logs/
kameorepowered
kameorepowered.exe
kameorepowered.pdb
kameorepowered.toml
/*.so
/*.dll

# Game assets extracted from the user's ISO
# (the ISO itself and anything derived from it must NEVER be committed)
/kameo.iso
/assets/
!/assets/.gitkeep
/out/iso_extract/

# Symbol exports derived from the game's debug symbols (copyrighted; the user
# supplies their own PDBs — see symbols/README.md)
/symbols/

# Title-update packages and anything extracted from them (copyrighted; the user
# supplies their own — see scripts/extract_tu.py)
/TU_*
/tu_extracted/
/update/
*.xexp

# Python caches
__pycache__/

# Third-party tools dropped by the user locally.
# Ignore the tree, but keep the scripts and README we wrote.
/tools/*
!/tools/README.md
!/tools/*.ps1

# Locally built libraries
/local/
CLAUDE.md

# Vendored renderer dependencies (plume RHI, XenosRecomp shader compiler).
# Cloned, not submodules yet -- see src/gfx/SHADERS.md for setup.
/thirdparty/

# Local copy of UnleashedRecomp used only as a reference implementation.
/Unleasherecompexample/
